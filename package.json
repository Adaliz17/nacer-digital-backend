{
  "name": "github-profile-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "description": "NestJS API for retrieving a public GitHub profile",
  "scripts": {
    "build": "nest build",
    "start": "nest start --exec \"node --use-system-ca\"",
    "start:dev": "nest start --watch --exec \"node --use-system-ca\"",
    "start:prod": "node --use-system-ca dist/main.js",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/axios": "4.0.1",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "axios": "1.18.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@types/node": "26.1.1",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
